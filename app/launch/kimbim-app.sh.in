#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Start the built KimBim with its pixi environment, without `pixi run app`.
# Generated by CMake in the build folder; override KIMBIM_ENV to use another environment.
here=$(cd "$(dirname "$0")" && pwd)
: "${KIMBIM_ENV:=@KIMBIM_LAUNCH_ENV@}"
if [ ! -d "$KIMBIM_ENV" ] && [ -n "$CONDA_PREFIX" ]; then KIMBIM_ENV=$CONDA_PREFIX; fi
: "${CONDA_PREFIX:=$KIMBIM_ENV}"
: "${KIMBIM_PYTHON_PATH:=@KIMBIM_LAUNCH_ROOT@/python}"
export CONDA_PREFIX KIMBIM_PYTHON_PATH
export LD_LIBRARY_PATH="$KIMBIM_ENV/lib:$LD_LIBRARY_PATH"
exec "$here/kimbim-app" "$@"
