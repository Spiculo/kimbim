@echo off
rem SPDX-License-Identifier: GPL-3.0-or-later
rem Start the built KimBim with its pixi environment, without `pixi run app`.
rem Generated by CMake in the build folder; override KIMBIM_ENV to use another environment.
setlocal
if not defined KIMBIM_ENV set "KIMBIM_ENV=@KIMBIM_LAUNCH_ENV@"
if not defined CONDA_PREFIX set "CONDA_PREFIX=%KIMBIM_ENV%"
if not defined KIMBIM_PYTHON_PATH set "KIMBIM_PYTHON_PATH=@KIMBIM_LAUNCH_ROOT@\python"
set "PATH=%KIMBIM_ENV%;%KIMBIM_ENV%\Library\bin;%KIMBIM_ENV%\Scripts;%PATH%"
"%~dp0kimbim-app.exe" %*
