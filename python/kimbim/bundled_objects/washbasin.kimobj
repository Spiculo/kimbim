  {"ellipse": {"cx": "width / 2", "cy": "depth * 0.45", "rx": "width / 2 - 0.07", "ry": "depth * 0.45 - 0.05"}},
  {"circle": {"cx": "width / 2", "cy": "depth - 0.06", "r": 0.02}}
 ]
}
