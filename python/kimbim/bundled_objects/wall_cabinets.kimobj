{
 "format": "kimbim-object/1",
 "id": "wall_cabinets",
 "name": {"en": "Wall cabinets", "es": "Muebles altos"},
 "category": "kitchen",
 "ifc": {"IFC4": ["IfcFurnitureType", "USERDEFINED", "KITCHENCABINET"], "IFC2X3": ["IfcFurnitureType", null, "KITCHENCABINET"]},
 "params": [
  {"key": "width", "kind": "length", "label": {"en": "Width", "es": "Ancho"}, "default": 1.2},
  {"key": "depth", "kind": "length", "label": {"en": "Depth", "es": "Fondo"}, "default": 0.35},
  {"key": "height", "kind": "length", "label": {"en": "Height", "es": "Altura"}, "default": 0.7},
  {"key": "elevation", "kind": "length", "label": {"en": "Mounting height", "es": "Altura de montaje"}, "default": 1.45, "min": 0.0, "max": 3.0},
  {"key": "units", "kind": "count", "label": {"en": "Units", "es": "Módulos"}, "default": 2, "min": 1, "max": 12}
 ],
 "materials": {"body": {"label": {"en": "Material", "es": "Material"}, "default": "Timber - finish"}},
 "parts": [
  {"id": "body", "box": {"z": "elevation", "dx": "width", "dy": "depth", "dz": "height"}}
 ],
 "symbol": [
  {"rect": {"x": 0, "y": 0, "dx": "width", "dy": "depth"}},
  {"line": {"points": [[0, 0], ["width", "depth"]]}},
  {"line": {"points": [["width", 0], [0, "depth"]]}},
  {"repeat": {"count": "units - 1"}, "line": {"points": [["width * (i + 1) / units", 0], ["width * (i + 1) / units", "depth"]]}}
 ]
}
