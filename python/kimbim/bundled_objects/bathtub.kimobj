{
 "format": "kimbim-object/1",
 "id": "bathtub",
 "name": {"en": "Bathtub", "es": "Bañera"},
 "category": "sanitary",
 "ifc": {"IFC4": ["IfcSanitaryTerminalType", "BATH", null]},
 "params": [
  {"key": "width", "kind": "length", "label": {"en": "Width", "es": "Ancho"}, "default": 1.7},
  {"key": "depth", "kind": "length", "label": {"en": "Depth", "es": "Fondo"}, "default": 0.75},
  {"key": "height", "kind": "length", "label": {"en": "Height", "es": "Altura"}, "default": 0.55}
 ],
 "materials": {"body": {"label": {"en": "Material", "es": "Material"}, "default": "Porcelain"}},
 "parts": [
  {"id": "base", "box": {"dx": "width", "dy": "depth", "dz": 0.06}},
  {"id": "wall_front", "box": {"z": 0.06, "dx": "width", "dy": 0.06, "dz": "height - 0.06"}},
  {"id": "wall_back", "box": {"y": "depth - 0.06", "z": 0.06, "dx": "width", "dy": 0.06, "dz": "height - 0.06"}},
  {"id": "wall_left", "box": {"y": 0.06, "z": 0.06, "dx": 0.06, "dy": "depth - 0.12", "dz": "height - 0.06"}},
  {"id": "wall_right", "box": {"x": "width - 0.06", "y": 0.06, "z": 0.06, "dx": 0.06, "dy": "depth - 0.12", "dz": "height - 0.06"}}
 ],
 "symbol": [
  {"rect": {"x": 0, "y": 0, "dx": "width", "dy": "depth"}},
  {"line": {"points": [{"rounded_rect": [0.06, 0.06, "width - 0.12", "depth - 0.12", "(depth - 0.12) * 0.45"], "n": 4}], "closed": true}},
  {"circle": {"cx": "width - 0.2", "cy": "depth / 2", "r": 0.03}}
 ]
}
